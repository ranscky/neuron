# --- Go binaries (CLI + registry) ---
# These are build outputs. Compile from source.
cli/neuron
registry/neuron-registry
registry/registry
cloud/neuron-cloud

# Any other top-level binaries that show up.
#
# `/registry` and `/server` used to be listed here. They also match the registry/
# source directory, so new files under it were ignored without a word — CI built
# a tree without registry/pkg/auth. Root-level directory names are not safe to
# ignore; name the binary instead.
/neuron

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Wheels and sdist
*.whl
*.tar.gz

# --- Node (runtime support, future MCP server tools) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Go ---
*.test
*.out
coverage.out
coverage.html
*.prof

