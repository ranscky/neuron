{
  "name": "agents/content-writer",
  "version": "1.0.1",
  "description": "Content writer that creates engaging content using web research and Ollama",
  "capability": {
    "input": [
      { "name": "topic", "type": "string", "required": true },
      { "name": "type", "type": "string", "required": false, "default": "blog" },
      { "name": "tone", "type": "string", "required": false, "default": "professional" },
      { "name": "length", "type": "string", "required": false, "default": "medium" }
    ],
    "output": {
      "type": "object",
      "format": "json"
    },
    "errors": ["search_failed", "generation_failed", "api_key_missing"]
  },
  "performance": {
    "avg_latency_ms": 2500,
    "p99_latency_ms": 6000,
    "success_rate": 0.95,
    "cost_per_call_usd": 0.000
  },
  "permissions": [
    "http",
    "env:TAVILY_API_KEY",
    "local:ollama"
  ],
  "models": [
    { "capability": "reasoning", "context": 32000 }
  ],
  "runtime": "python",
  "entry": "main.py",
  "dependencies": {
    "tools/web-search": "^1.0.0"
  },
  "neuron": "1"
}