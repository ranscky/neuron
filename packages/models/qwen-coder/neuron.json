{
  "name": "models/qwen-coder",
  "version": "1.0.0",
  "description": "Qwen3 Coder model abstraction for code generation",
  "capability": {
    "input": [
      { "name": "prompt", "type": "string", "required": true },
      { "name": "system", "type": "string", "required": false, "default": "You are an expert programmer" },
      { "name": "temperature", "type": "float", "required": false, "default": 0.7 },
      { "name": "max_tokens", "type": "integer", "required": false, "default": 2048 }
    ],
    "output": {
      "type": "object",
      "format": "json"
    },
    "errors": ["api_error", "invalid_request", "model_unavailable"]
  },
  "performance": {
    "avg_latency_ms": 1500,
    "p99_latency_ms": 4000,
    "success_rate": 0.97,
    "cost_per_call_usd": 0.000
  },
  "permissions": [
    "local:ollama"
  ],
  "models": [
    { "capability": "coding", "context": 32000 }
  ],
  "runtime": "python",
  "entry": "main.py",
  "dependencies": {},
  "neuron": "1"
}