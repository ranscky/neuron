{
  "name": "rag/notion-sync",
  "version": "1.0.0",
  "description": "Sync Notion databases and query content using Ollama",
  "capability": {
    "input": [
      { "name": "action", "type": "string", "required": true, "enum": ["sync", "query"] },
      { "name": "database_id", "type": "string", "required": false },
      { "name": "question", "type": "string", "required": false }
    ],
    "output": {
      "type": "object",
      "format": "json"
    },
    "errors": ["sync_failed", "query_failed", "api_key_missing", "invalid_action"]
  },
  "performance": {
    "avg_latency_ms": 1500,
    "p99_latency_ms": 3000,
    "success_rate": 0.92,
    "cost_per_call_usd": 0.000
  },
  "permissions": [
    "http",
    "env:NOTION_API_KEY"
  ],
  "models": [
    { "capability": "reasoning", "context": 32000 }
  ],
  "runtime": "python",
  "entry": "main.py",
  "dependencies": {},
  "neuron": "1"
}