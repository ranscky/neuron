{
  "name": "rag/pdf-reader",
  "version": "1.0.1",
  "description": "Extract information from PDF files and answer questions using Ollama",
  "capability": {
    "input": [
      { "name": "file_path", "type": "string", "required": true },
      { "name": "question", "type": "string", "required": true },
      { "name": "max_pages", "type": "integer", "required": false, "default": 50 }
    ],
    "output": {
      "type": "object",
      "format": "json"
    },
    "errors": ["file_not_found", "invalid_pdf", "ollama_error", "processing_error"]
  },
  "performance": {
    "avg_latency_ms": 2000,
    "p99_latency_ms": 5000,
    "success_rate": 0.90,
    "cost_per_call_usd": 0.000
  },
  "permissions": [
    "file:read",
    "local:ollama"
  ],
  "models": [
    { "capability": "reasoning", "context": 128000 }
  ],
  "runtime": "python",
  "entry": "main.py",
  "dependencies": {},
  "neuron": "1"
}
